# Install this file as /etc/av1-encoder.conf, owned by root and not writable by
# the account running the AV1 encoder services.

SOURCE_ROOT="/srv/video/incoming"
OUTPUT_ROOT="/srv/video/av1"
QUEUE_DIR="/var/lib/av1-encoder/queue"
FAILED_DIR="/var/lib/av1-encoder/failed"
LOG_DIR="/var/log/av1-encoder"

# SVT-AV1 settings
AV1_PRESET="6"
AV1_CRF="28"
