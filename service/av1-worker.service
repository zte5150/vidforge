[Unit]
Description=AV1 video encoding queue worker
After=local-fs.target
RequiresMountsFor=/srv/video/incoming /srv/video/av1

[Service]
User=av1-encoder
Group=av1-encoder
Environment=HOME=/var/lib/av1-encoder
Environment=XDG_RUNTIME_DIR=/run/av1-encoder
StateDirectory=av1-encoder
LogsDirectory=av1-encoder
RuntimeDirectory=av1-encoder
ExecStart=/usr/bin/av1-queue-worker
Restart=on-failure
RestartSec=10
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
TimeoutStopSec=300
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
